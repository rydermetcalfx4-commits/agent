# Send local_agent.py traces to Honeycomb (US). No secrets here: the ingest key comes from
# HONEYCOMB_API_KEY in the git-ignored .env at the repo root.
#   set -a; . ./.env; . offline/honeycomb.env; set +a
#   python3 offline/local_agent.py "…"
OTEL_SERVICE_NAME=local-agent
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=${HONEYCOMB_API_KEY}
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
# Records prompts and replies (truncated) as span attributes; remove to keep them out of traces.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=span_only
