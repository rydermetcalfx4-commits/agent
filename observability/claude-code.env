# Send Claude Code's own telemetry (prompts, API requests, tool decisions/results, hooks, cost, tokens)
# to Honeycomb. Add these as environment variables in the cloud environment's settings, with
# HONEYCOMB_API_KEY set to a Honeycomb ingest key; Claude Code reads them at startup.
# Locally: export HONEYCOMB_API_KEY=…; set -a; . observability/claude-code.env; set +a; claude
# Events land in the `claude-code` dataset, metrics in the environment's metrics dataset.
CLAUDE_CODE_ENABLE_TELEMETRY=1
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=${HONEYCOMB_API_KEY}
OTEL_EXPORTER_OTLP_METRICS_HEADERS=x-honeycomb-team=${HONEYCOMB_API_KEY},x-honeycomb-dataset=claude-code-metrics
# Include tool names/arguments in tool events (useful for /evolve's failure mining).
OTEL_LOG_TOOL_DETAILS=1
