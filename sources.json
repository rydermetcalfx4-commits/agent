{
  "_doc": "Upstream sources scraped by scripts/import_sources.py. catalog: text-only (.md) copies, searchable via scripts/catalog.py, not auto-loaded. promote: full directories copied into .claude/skills (or .claude/agents). files: individual files copied verbatim. rewrite: literal string replacements applied to promoted files. Revisions are pinned in sources.lock.",
  "sources": [
    {
